# Genius API: https://genius.com/api-clients -> "Generate Access Token"
GENIUS_ACCESS_TOKEN=

# Hugging Face (embedding model download): https://huggingface.co/settings/tokens
HF_TOKEN=

# Infra (matches docker-compose.yml)
POSTGRES_DSN=postgresql://genius:genius@localhost:5432/genius

# LLM (generation stage)
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# Langfuse tracing (optional): https://cloud.langfuse.com -> project -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
